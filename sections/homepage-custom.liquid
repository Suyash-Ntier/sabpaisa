<section id="homepage-{{ section.id }}" class="homepage-custom" style="background-color: {{ section.settings.background_color }}; font-family: {{ section.settings.font_family }};">
  <div class="hp-hero" style="background-image: linear-gradient(180deg, rgba(5,58,102,0.75) 0%, rgba(0,0,0,0.45) 100%), url({{ section.settings.hero_image | img_url: '2048x' }});">
    <div class="hp-hero-inner">
      <div class="hp-hero-eyebrow">#KeffyIt</div>
      <h1 class="hp-hero-title">{{ section.settings.hero_heading }}</h1>
      <p class="hp-hero-copy">{{ section.settings.hero_subheading }}</p>
      {% if section.settings.cta_text != blank %}
        <a href="{{ section.settings.cta_link }}" class="hp-hero-button">{{ section.settings.cta_text }}</a>
      {% endif %}
    </div>
  </div>

  <div class="hp-container">
    <div class="hp-section hp-wellness">
      <div class="hp-section-heading-group">
        <span class="hp-section-eyebrow">Balancing Your wellness triangle</span>
        <p class="hp-section-copy">{{ section.settings.wellness_copy }}</p>
      </div>
      <div class="hp-wellness-grid">
        {% for block in section.blocks %}
          {% if block.type == 'wellness_feature' %}
            <article class="hp-wellness-card">
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="hp-section hp-values">
      <div class="hp-values-grid">
        {% for block in section.blocks %}
          {% if block.type == 'value_card' %}
            <div class="hp-value-card">
              <p class="hp-value-text">{{ block.settings.title }}</p>
              <p>{{ block.settings.text }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="hp-section hp-about">
      <div class="hp-about-title">{{ section.settings.about_heading }}</div>
      <p>{{ section.settings.about_text }}</p>
    </div>

    <div class="hp-section hp-split">
      <div class="hp-split-card">
        <h2>{{ section.settings.vision_heading }}</h2>
        <p>{{ section.settings.vision_text }}</p>
      </div>
      <div class="hp-split-card hp-split-card--alt">
        <h2>{{ section.settings.science_heading }}</h2>
        <p>{{ section.settings.science_text }}</p>
        <p class="hp-split-caption">{{ section.settings.capsules_text }}</p>
      </div>
    </div>

    {% if section.settings.video_url != blank %}
      {% assign video_id = section.settings.video_url | split: '/' | last | split: '?' | first %}
      <div class="hp-section hp-video">
        <div class="hp-video-frame">
          <iframe src="https://player.vimeo.com/video/{{ video_id }}" frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
        </div>
      </div>
    {% endif %}

    <div class="hp-section hp-bundles">
      <div class="hp-section-headline">
        <h2>Featured Bundles</h2>
      </div>
      <div class="hp-bundle-grid">
        {% for block in section.blocks %}
          {% if block.type == 'bundle_product' %}
            <article class="hp-bundle-card">
              <div class="hp-bundle-card-badge">{{ block.settings.badge_text }}</div>
              <div class="hp-bundle-card-header">
                <h3>{{ block.settings.title }}</h3>
                <span class="hp-bundle-price">{{ block.settings.price_text }}</span>
              </div>
              {% if block.settings.product != blank %}
                {% assign product = all_products[block.settings.product] %}
                {% if product and product.featured_image %}
                  <img src="{{ product.featured_image | img_url: '480x480' }}" alt="{{ product.title }}" class="hp-bundle-card-image">
                {% endif %}
                {% if product %}
                  <div class="hp-bundle-card-meta">
                    <a href="{{ product.url }}" class="hp-bundle-link">View product</a>
                  </div>
                {% endif %}
              {% endif %}
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="hp-section hp-products-out">
      <div class="hp-section-headline">
        <h2>Products to look out for</h2>
      </div>
      <div class="hp-category-grid">
        {% for block in section.blocks %}
          {% if block.type == 'category_card' %}
            <a href="{{ block.settings.link }}" class="hp-category-card">
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.subtitle }}</p>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="hp-section hp-testimonials">
      <div class="hp-testimonial-grid">
        {% for block in section.blocks %}
          {% if block.type == 'testimonial' %}
            <figure class="hp-testimonial-card">
              <blockquote>“{{ block.settings.quote }}”</blockquote>
              <figcaption>{{ block.settings.author }}</figcaption>
            </figure>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="hp-section hp-newsletter">
      <div class="hp-newsletter-copy">
        <h2>{{ section.settings.newsletter_heading }}</h2>
        <p>{{ section.settings.newsletter_text }}</p>
      </div>
      <form action="/contact#contact_form" method="post" accept-charset="UTF-8" class="hp-newsletter-form">
        <input type="email" name="contact[email]" placeholder="Enter your email" required>
        <button type="submit" class="hp-cta hp-cta--small">{{ section.settings.newsletter_button_text }}</button>
      </form>
    </div>
  </div>

  {% schema %}
  {
    "name": "Homepage - Custom",
    "settings": [
      { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
      { "type": "text", "id": "hero_heading", "label": "Hero heading", "default": "Say Hello to the Keffy Way of Life" },
      { "type": "textarea", "id": "hero_subheading", "label": "Hero subheading", "default": "At KEFFY, we're not just about selling supplements; we're all about being your trusted friend on your wellness journey." },
      { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Shop now" },
      { "type": "url", "id": "cta_link", "label": "CTA link", "default": "/collections/all" },
      { "type": "textarea", "id": "wellness_copy", "label": "Wellness section text", "default": "Think of it as your daily dose of happy hormones. Regular physical activity isn't just about staying fit; it's a pathway to a happier, healthier you." },
      { "type": "text", "id": "about_heading", "label": "About heading", "default": "#KeffyIt" },
      { "type": "textarea", "id": "about_text", "label": "About text", "default": "We also draw inspiration from the Greek term \"kefi,\" a celebration of life and the joy of feeling good. At KEFFY, we're all about creating that joy and contributing to your vibrant life." },
      { "type": "text", "id": "vision_heading", "label": "Vision heading", "default": "Our Vision" },
      { "type": "textarea", "id": "vision_text", "label": "Vision text", "default": "At KEFFY, our vision is to make wellness a habit, not a chore. We aspire to be a reliable partner in your journey to a healthier life." },
      { "type": "text", "id": "science_heading", "label": "Science heading", "default": "a powerful Blend of Science and nature" },
      { "type": "textarea", "id": "science_text", "label": "Science text", "default": "Our capsules are all natural and safe to consume. Let them guide you to wellness, one day at a time." },
      { "type": "textarea", "id": "capsules_text", "label": "Capsules caption", "default": "Designed with clinically-inspired formulas that help support your body, mind, and mood." },
      { "type": "text", "id": "video_url", "label": "Video URL", "default": "https://vimeo.com/885617514" },
      { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Join our wellness community" },
      { "type": "textarea", "id": "newsletter_text", "label": "Newsletter text", "default": "Sign up to get exclusive updates, offers, and healthy living tips from KEFFY." },
      { "type": "text", "id": "newsletter_button_text", "label": "Newsletter button text", "default": "Subscribe" },
      { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" },
      { "type": "select", "id": "font_family", "label": "Font family for homepage", "options": [
        { "value": "'Poppins', Arial, sans-serif", "label": "Poppins" },
        { "value": "'Playfair Display', serif", "label": "Playfair Display" },
        { "value": "'Roboto', Arial, sans-serif", "label": "Roboto" },
        { "value": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif", "label": "System UI" }
      ], "default": "'Poppins', Arial, sans-serif" }
    ],
    "blocks": [
      { "type": "wellness_feature", "name": "Wellness feature", "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ] },
      { "type": "value_card", "name": "Value card", "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ] },
      { "type": "bundle_product", "name": "Featured bundle", "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "price_text", "label": "Price text" },
        { "type": "text", "id": "badge_text", "label": "Badge text" }
      ] },
      { "type": "category_card", "name": "Category card", "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "subtitle", "label": "Subtitle" },
        { "type": "url", "id": "link", "label": "Link" }
      ] },
      { "type": "testimonial", "name": "Testimonial", "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "author", "label": "Author" }
      ] }
    ],
    "max_blocks": 20,
    "presets": [
      { "name": "Homepage Custom", "category": "Homepage" }
    ]
  }
  {% endschema %}
</section>
