<section class="keffy-showcase-{{ section.id }}">
  <div class="page-width">
    <div class="keffy-showcase__grid">

      <div class="keffy-showcase__left">
        {% if section.settings.main_image != blank %}
          {{
            section.settings.main_image
            | image_url: width: 1600
            | image_tag:
              class: 'keffy-showcase__main-image',
              loading: 'lazy',
              widths: '600, 900, 1200, 1600'
          }}
        {% endif %}
      </div>

      <div class="keffy-showcase__right">

        {% assign product = section.settings.product %}

        {% if product != blank %}
          <a href="{{ product.url }}" class="keffy-showcase__product-card">

            <div class="keffy-showcase__product-image-wrap">
              {% if product.featured_image != blank %}
                {{
                  product.featured_image
                  | image_url: width: 900
                  | image_tag:
                    class: 'keffy-showcase__product-image',
                    loading: 'lazy',
                    widths: '300, 500, 700, 900'
                }}
              {% endif %}
            </div>

            <div class="keffy-showcase__content">
              <div class="keffy-showcase__vendor">
                {{ product.vendor }}
              </div>

              <h3 class="keffy-showcase__title">
                {{ product.title }}
              </h3>

              <div class="keffy-showcase__price">
                {{ product.price | money }}
              </div>
            </div>

          </a>
        {% endif %}

        <div class="keffy-showcase__pagination">
          <span class="dot"></span>
          <span class="dot active"></span>
          <span class="dot"></span>
          <span class="dot"></span>
        </div>

      </div>

    </div>
  </div>
</section>

<style>
  .keffy-showcase-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .keffy-showcase-{{ section.id }} .keffy-showcase__grid {
    display: grid;
    grid-template-columns: 1.7fr 0.7fr;
    gap: 40px;
    align-items: start;
  }

  .keffy-showcase-{{ section.id }} .keffy-showcase__left {
    overflow: hidden;
  }

  .keffy-showcase-{{ section.id }} .keffy-showcase__main-image {
    width: 100%;
    display: block;
    height: auto;
  }

  .keffy-showcase-{{ section.id }} .keffy-showcase__product-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .keffy-showcase-{{ section.id }} .keffy-showcase__product-image-wrap {
    overflow: hidden;
    background: #f5f5f5;
  }

  .keffy-showcase-{{ section.id }} .keffy-showcase__product-image {
    width: 100%;
    display: block;
    height: auto;
    transition: transform 0.5s ease;
  }

  .keffy-showcase-{{ section.id }} .keffy-showcase__product-card:hover .keffy-showcase__product-image {
    transform: scale(1.03);
  }

  .keffy-showcase-{{ section.id }} .keffy-showcase__content {
    padding-top: 20px;
  }

  .keffy-showcase-{{ section.id }} .keffy-showcase__vendor {
    font-size: 16px;
    color: #777;
    margin-bottom: 10px;
    line-height: 1.4;
  }

  .keffy-showcase-{{ section.id }} .keffy-showcase__title {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: 42px;
    line-height: 1.15;
    font-weight: 600;
  }

  .keffy-showcase-{{ section.id }} .keffy-showcase__price {
    margin-top: 14px;
    color: {{ section.settings.price_color }};
    font-size: 32px;
    font-weight: 700;
  }

  .keffy-showcase-{{ section.id }} .keffy-showcase__pagination {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 40px;
  }

  .keffy-showcase-{{ section.id }} .keffy-showcase__pagination .dot {
    width: 34px;
    height: 2px;
    background: #d5d5d5;
    display: block;
  }

  .keffy-showcase-{{ section.id }} .keffy-showcase__pagination .dot.active {
    background: {{ section.settings.active_dot_color }};
  }

  @media screen and (max-width: 989px) {
    .keffy-showcase-{{ section.id }} .keffy-showcase__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .keffy-showcase-{{ section.id }} .keffy-showcase__title {
      font-size: 34px;
    }

    .keffy-showcase-{{ section.id }} .keffy-showcase__price {
      font-size: 28px;
    }
  }

  @media screen and (max-width: 749px) {
    .keffy-showcase-{{ section.id }} {
      padding-top: 50px;
      padding-bottom: 50px;
    }

    .keffy-showcase-{{ section.id }} .keffy-showcase__title {
      font-size: 28px;
    }

    .keffy-showcase-{{ section.id }} .keffy-showcase__price {
      font-size: 24px;
    }

    .keffy-showcase-{{ section.id }} .keffy-showcase__pagination {
      justify-content: center;
    }
  }
</style>

{% schema %}
{
  "name": "Keffy Featured Showcase",
  "settings": [
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Left lifestyle image"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Featured product"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#F7F7F7"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Title color",
      "default": "#26324B"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price color",
      "default": "#5D3EFF"
    },
    {
      "type": "color",
      "id": "active_dot_color",
      "label": "Active pagination color",
      "default": "#5D3EFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Keffy Featured Showcase"
    }
  ]
}
{% endschema %}